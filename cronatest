		{ Offset = Vector2.new(1, 0) }):Play()

	local sidebar = Instance.new("Frame")
	sidebar.Position = UDim2.fromOffset(8, 44)
	sidebar.Size = UDim2.new(0, 118, 1, -52)
	sidebar.BorderSizePixel = 0
	bind(sidebar, "BackgroundColor3", "Sidebar")
	sidebar.BackgroundTransparency = 0.2
	sidebar.Parent = main
	corner(sidebar, 8)
	local sideLayout = Instance.new("UIListLayout")
	sideLayout.Padding = UDim.new(0, 4)
	sideLayout.Parent = sidebar
	local sidePad = Instance.new("UIPadding")
	sidePad.PaddingTop, sidePad.PaddingLeft, sidePad.PaddingRight =
		UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 6)
	sidePad.Parent = sidebar

	local content = Instance.new("Frame")
	content.Position = UDim2.fromOffset(134, 44)
	content.Size = UDim2.new(1, -142, 1, -52)
	content.BackgroundTransparency = 1
	content.ClipsDescendants = true
	content.Parent = main

	---------------------------------------------------------------- open / close animation
	function window:SetVisible(v)
		window.Open = v
		if v then
			main.Visible = true
			tween(scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
			tween(main, { GroupTransparency = 0 }, 0.25)
		else
			tween(scale, { Scale = 0.92 }, 0.2)
			tween(main, { GroupTransparency = 1 }, 0.2)
			task.delay(0.22, function()
				if not window.Open then main.Visible = false end
			end)
		end
	end
	window:SetVisible(true)

	---------------------------------------------------------------- input
	local dragging, dragStart, startPos
	title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, input.Position, main.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == (opts.ToggleKey or Enum.KeyCode.RightShift) then
			window:SetVisible(not window.Open)
		end
	end)

	---------------------------------------------------------------- config (session-only)
	local function commit(flag, value, silent, callback)
		window.Flags[flag] = value
		if silent then return end
		if callback then task.spawn(callback, value) end
		if autoSave and not window._loading then window:SaveConfig() end
	end

	function window:SaveConfig()
		localPlayer:SetAttribute(configKey, HttpService:JSONEncode(self.Flags))
	end

	function window:LoadConfig()
		local raw = localPlayer:GetAttribute(configKey)
		if type(raw) ~= "string" then return false end
		local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or type(data) ~= "table" then return false end
		self._loading = true
		for flag, value in pairs(data) do
			local setter = self.Setters[flag]
			if setter then setter(value, false) end
		end
		self._loading = false
		return true
	end

	---------------------------------------------------------------- themes
	function window:SetTheme(name, silent)
		local t = Themes[name]
		if not t then return end
		theme = t
		window.ThemeName = name
		for _, b in ipairs(bindings) do
			tween(b.obj, { [b.prop] = b.fn(t) }, 0.4)
		end
		for _, g in ipairs(gradients) do
			g.Color = gradSeq(t)
		end
		buildBackground()
		commit("Theme", name, silent)
	end
	window.Setters.Theme = function(v, silent) window:SetTheme(v, silent) end

	---------------------------------------------------------------- tabs
	local function refreshTabs(slide)
		for _, t in ipairs(window.Tabs) do
			local sel = window.Selected == t
			tween(t.Button, {
				BackgroundColor3 = sel and theme.Element or theme.Sidebar,
				TextColor3 = sel and theme.Text or theme.SubText,
			})
			tween(t.Stripe, { Size = UDim2.fromOffset(3, sel and 16 or 0) }, 0.25, Enum.EasingStyle.Back)
			t.Page.Visible = sel
			if sel and slide then
				t.Page.Position = UDim2.fromOffset(0, 16)
				tween(t.Page, { Position = UDim2.fromOffset(0, 0) }, 0.28, Enum.EasingStyle.Quint)
			end
		end
	end

	function window:CreateTab(o)
		local tab = {}

		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, 30)
		button.BorderSizePixel = 0
		button.Text = o.Name
		button.Font = Enum.Font.Gotham
		button.TextSize = 13
		button.AutoButtonColor = false
		bind(button, "BackgroundColor3", function(t) return window.Selected == tab and t.Element or t.Sidebar end)
		bind(button, "TextColor3", function(t) return window.Selected == tab and t.Text or t.SubText end)
		button.BackgroundTransparency = 0.2
		button.Parent = sidebar
		corner(button, 6)

		local stripe = Instance.new("Frame")
		stripe.AnchorPoint = Vector2.new(0, 0.5)
		stripe.Position = UDim2.new(0, 3, 0.5, 0)
		stripe.Size = UDim2.fromOffset(3, 0)
		stripe.BorderSizePixel = 0
		bind(stripe, "BackgroundColor3", "Accent")
		stripe.Parent = button
		corner(stripe, 2)

		local page = Instance.new("ScrollingFrame")
		page.Size = UDim2.fromScale(1, 1)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 3
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.CanvasSize = UDim2.new()
		page.Visible = false
		page.Parent = content
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 6)
		layout.Parent = page
		local pad = Instance.new("UIPadding")
		pad.PaddingRight = UDim.new(0, 8)
		pad.Parent = page

		tab.Page, tab.Button, tab.Stripe = page, button, stripe
		table.insert(window.Tabs, tab)

		button.MouseButton1Click:Connect(function()
			if window.Selected == tab then return end
			window.Selected = tab
			refreshTabs(true)
		end)
		if #window.Tabs == 1 then
			window.Selected = tab
			refreshTabs(true)
		end

		local function makeRow(height, noHover)
			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, 0, 0, height)
			row.BorderSizePixel = 0
			row.Text = ""
			row.AutoButtonColor = false
			bind(row, "BackgroundColor3", "Element")
			row.BackgroundTransparency = 0.15
			row.Parent = page
			corner(row, 6)
			if not noHover then
				row.MouseEnter:Connect(function()
					tween(row, { BackgroundColor3 = theme.Element:Lerp(Color3.new(1, 1, 1), 0.07) }, 0.12)
				end)
				row.MouseLeave:Connect(function()
					tween(row, { BackgroundColor3 = theme.Element }, 0.15)
				end)
			end
			return row
		end

		function tab:CreateSection(name)
			local l = makeLabel(page, name, nil, "SubText")
			l.Size = UDim2.new(1, 0, 0, 18)
			l.Font = Enum.Font.GothamBold
			l.TextSize = 12
		end

		function tab:CreateLabel(text)
			local row = makeRow(28, true)
			local l = makeLabel(row, text, nil, "SubText")
			l.Position = UDim2.fromOffset(10, 0)
			l.Size = UDim2.new(1, -20, 1, 0)
		end

		function tab:CreateParagraph(o)
			local row = makeRow(78, true)
			local t = makeLabel(row, o.Title, nil, "Text")
			t.Position = UDim2.fromOffset(14, 10)
			t.Size = UDim2.new(1, -28, 0, 26)
			t.Font = Enum.Font.GothamBold
			t.TextSize = 20
			if o.Animated then
				t.TextColor3 = Color3.new(1, 1, 1)
				-- unbind the themed color so the gradient controls the look
				for i = #bindings, 1, -1 do
					if bindings[i].obj == t then table.remove(bindings, i) end
				end
				local g = addGradient(t)
				g.Offset = Vector2.new(-1, 0)
				TweenService:Create(g,
					TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
					{ Offset = Vector2.new(1, 0) }):Play()
			end
			local c = makeLabel(row, o.Content or "", nil, "SubText")
			c.Position = UDim2.fromOffset(14, 40)
			c.Size = UDim2.new(1, -28, 0, 30)
			c.TextWrapped = true
			c.TextYAlignment = Enum.TextYAlignment.Top
		end

		function tab:CreateButton(o)
			local row = makeRow(32)
			local l = makeLabel(row, o.Name, Enum.TextXAlignment.Center)
			l.Size = UDim2.fromScale(1, 1)
			row.MouseButton1Click:Connect(function()
				row.BackgroundColor3 = theme.Accent
				tween(row, { BackgroundColor3 = theme.Element }, 0.35)
				if o.Callback then task.spawn(o.Callback) end
			end)
		end

		function tab:CreateToggle(o)
			local flag = o.Flag or o.Name
			local value = false
			local row = makeRow(32)
			local l = makeLabel(row, o.Name)
			l.Position = UDim2.fromOffset(10, 0)
			l.Size = UDim2.new(1, -60, 1, 0)

			local track = Instance.new("Frame")
			track.Size = UDim2.fromOffset(36, 18)
			track.Position = UDim2.new(1, -46, 0.5, -9)
			track.BorderSizePixel = 0
			bind(track, "BackgroundColor3", function(t) return value and t.Accent or t.Background end)
			track.Parent = row
			corner(track, 9)
			local knob = Instance.new("Frame")
			knob.Size = UDim2.fromOffset(14, 14)
			knob.Position = UDim2.fromOffset(2, 2)
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
			knob.BorderSizePixel = 0
			knob.Parent = track
			corner(knob, 7)

			local function set(v, silent)
				value = v == true
				tween(track, { BackgroundColor3 = value and theme.Accent or theme.Background })
				tween(knob, { Position = UDim2.fromOffset(value and 20 or 2, 2) }, 0.25, Enum.EasingStyle.Back)
				commit(flag, value, silent, o.Callback)
			end
			row.MouseButton1Click:Connect(function() set(not value) end)
			window.Setters[flag] = set
			set(o.Default == true, true)
			return { Set = function(_, v) set(v) end }
		end

		function tab:CreateSlider(o)
			local flag = o.Flag or o.Name
			local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
			local row = makeRow(46, true)

			local l = makeLabel(row, o.Name)
			l.Position = UDim2.fromOffset(10, 4)
			l.Size = UDim2.new(0.6, 0, 0, 16)
			local valueLabel = makeLabel(row, "", Enum.TextXAlignment.Right, "SubText")
			valueLabel.Position = UDim2.new(0.6, 0, 0, 4)
			valueLabel.Size = UDim2.new(0.4, -10, 0, 16)

			local hit = Instance.new("Frame")
			hit.BackgroundTransparency = 1
			hit.Position = UDim2.fromOffset(10, 26)
			hit.Size = UDim2.new(1, -20, 0, 14)
			hit.Parent = row
			local track = Instance.new("Frame")
			track.AnchorPoint = Vector2.new(0, 0.5)
			track.Position = UDim2.fromScale(0, 0.5)
			track.Size = UDim2.new(1, 0, 0, 6)
			track.BorderSizePixel = 0
			bind(track, "BackgroundColor3", "Background")
			track.Parent = hit
			corner(track, 3)
			local fill = Instance.new("Frame")
			fill.BorderSizePixel = 0
			bind(fill, "BackgroundColor3", "Accent")
			fill.Parent = track
			corner(fill, 3)

			local function set(v, silent)
				v = math.clamp(tonumber(v) or min, min, max)
				v = min + math.floor((v - min) / inc + 0.5) * inc
				v = tonumber(string.format("%.3f", math.clamp(v, min, max)))
				valueLabel.Text = tostring(v)
				tween(fill, { Size = UDim2.fromScale((v - min) / (max - min), 1) }, 0.08)
				commit(flag, v, silent, o.Callback)
			end

			local sliding = false
			local function fromX(x)
				local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				set(min + alpha * (max - min))
			end
			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					fromX(input.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					fromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)

			window.Setters[flag] = set
			set(o.Default or min, true)
			return { Set = function(_, v) set(v) end }
		end

		-- Click-to-cycle dropdown
		function tab:CreateDropdown(o)
			local flag = o.Flag or o.Name
			local options = o.Options
			local value = options[1]
			local row = makeRow(32)
			local l = makeLabel(row, o.Name)
			l.Position = UDim2.fromOffset(10, 0)
			l.Size = UDim2.new(0.5, 0, 1, 0)
			local valueLabel = makeLabel(row, "", Enum.TextXAlignment.Right, "Accent")
			valueLabel.Position = UDim2.new(0.5, 0, 0, 0)
			valueLabel.Size = UDim2.new(0.5, -10, 1, 0)

			local function set(v, silent)
				if not table.find(options, v) then return end
				value = v
				valueLabel.Text = v
				commit(flag, v, silent, o.Callback)
			end
			row.MouseButton1Click:Connect(function()
				set(options[(table.find(options, value) % #options) + 1])
			end)
			window.Setters[flag] = set
			set(o.Default or options[1], true)
			return { Set = function(_, v) set(v) end }
		end

		-- One row per theme: name, color swatches, check mark on the active one
		function tab:CreateThemePicker()
			for _, name in ipairs(ThemeOrder) do
				local t = Themes[name]
				local row = makeRow(32)
				local l = makeLabel(row, name)
				l.Position = UDim2.fromOffset(10, 0)
				l.Size = UDim2.new(1, -110, 1, 0)

				local check = makeLabel(row, "✓", Enum.TextXAlignment.Center, "Accent")
				check.Position = UDim2.new(1, -92, 0, 0)
				check.Size = UDim2.fromOffset(20, 32)
				check.Font = Enum.Font.GothamBold
				bind(check, "TextTransparency", function() return window.ThemeName == name and 0 or 1 end)

				for i, c in ipairs({ t.Accent, t.Accent2 }) do
					local sw = Instance.new("Frame")
					sw.Size = UDim2.fromOffset(16, 16)
					sw.Position = UDim2.new(1, -62 + (i - 1) * 22, 0.5, -8)
					sw.BackgroundColor3 = c
					sw.BorderSizePixel = 0
					sw.Parent = row
					corner(sw, 8)
				end

				row.MouseButton1Click:Connect(function() window:SetTheme(name) end)
			end
		end

		return tab
	end

	return window
end

