	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	local main = Instance.new("CanvasGroup")
	main.Size = UDim2.fromOffset(540, 380)
	main.Position = UDim2.new(0.5, -270, 0.5, -190)
	main.BorderSizePixel = 0
	main.GroupTransparency = 1
	bind(main, "BackgroundColor3", "Background")
	main.Parent = gui
	corner(main, 10)

	local scale = Instance.new("UIScale")
	scale.Scale = 0.9
	scale.Parent = main

	---------------------------------------------------------------- animated background
	local bgLayer = Instance.new("Frame")
	bgLayer.Name = "Background"
	bgLayer.Size = UDim2.fromScale(1, 1)
	bgLayer.BackgroundTransparency = 1
	bgLayer.ClipsDescendants = true
	bgLayer.ZIndex = 0
	bgLayer.Parent = main

