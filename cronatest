	TweenService:Create(washGrad,
		TweenInfo.new(14, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
		{ Rotation = 360 }):Play()

	local particles, bgToken = {}, 0

	local function rand(a, b)
		return a + math.random() * (b - a)
	end

	local function clearBackground()
		bgToken += 1
		for _, p in ipairs(particles) do p:Destroy() end
		table.clear(particles)
	end

	local function spawnParticle(kind, token)
		if token ~= bgToken then return end

		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BackgroundColor3 = math.random() < 0.5 and theme.Accent or theme.Accent2
		f.BackgroundTransparency = 1
		f.ZIndex = 0

		local startPos, goalPos, dur, peak
		if kind == "orbs" then -- soft glowing circles drifting up
			local s = rand(14, 34)
			f.Size = UDim2.fromOffset(s, s)
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			local x = rand(0.05, 0.95)
			startPos = UDim2.fromScale(x, 1.1)
			goalPos = UDim2.fromScale(x + rand(-0.12, 0.12), -0.1)
			dur, peak = rand(8, 14), 0.8
		elseif kind == "stars" then -- twinkling dots with a tiny drift
			local s = rand(2, 3.5)
			f.Size = UDim2.fromOffset(s, s)
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			local x, y = rand(0.03, 0.97), rand(0.03, 0.97)
			startPos = UDim2.fromScale(x, y)
			goalPos = UDim2.fromScale(x + rand(-0.02, 0.02), y + rand(-0.02, 0.02))
			dur, peak = rand(1.6, 3.6), 0.25
		elseif kind == "embers" then -- small sparks rising and swaying
			local s = rand(3, 5)
			f.Size = UDim2.fromOffset(s, s)
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			local x = rand(0.05, 0.95)
			startPos = UDim2.fromScale(x, 1.05)
			goalPos = UDim2.fromScale(x + rand(-0.15, 0.15), rand(0.1, 0.5))
			dur, peak = rand(3, 6), 0.3
		elseif kind == "rain" then -- thin falling lines
			f.Size = UDim2.fromOffset(2, rand(10, 22))
			local x = rand(0.03, 0.97)
			startPos = UDim2.fromScale(x, -0.1)
			goalPos = UDim2.fromScale(x, 1.1)
			dur, peak = rand(2.5, 5), 0.65
		else -- "streaks": glowing lines sweeping diagonally
			f.Size = UDim2.fromOffset(rand(60, 120), 2)
			f.Rotation = -15
			local y = rand(0.4, 1.2)
			startPos = UDim2.fromScale(-0.2, y)
			goalPos = UDim2.fromScale(1.2, y - 0.5)
			dur, peak = rand(3, 5.5), 0.6
		end

		f.Position = startPos
		f.Parent = bgLayer
		table.insert(particles, f)

		local move = TweenService:Create(f,
			TweenInfo.new(dur, Enum.EasingStyle.Linear), { Position = goalPos })
		local fade = TweenService:Create(f,
			TweenInfo.new(dur / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true),
			{ BackgroundTransparency = peak })

		move.Completed:Connect(function()
			local i = table.find(particles, f)
			if i then table.remove(particles, i) end
			f:Destroy()
			spawnParticle(kind, token) -- respawn (no-op if the theme changed meanwhile)
		end)
		move:Play()
		fade:Play()
	end

	local function buildBackground()
		clearBackground()
		if not bgLayer.Visible then return end
		local kind = BackgroundStyles[window.ThemeName] or "orbs"
		local token = bgToken
		for _ = 1, BackgroundCounts[kind] or 12 do
			task.delay(math.random() * 3, spawnParticle, kind, token)
		end
	end

	function window:SetBackground(on)
		bgLayer.Visible = on
		buildBackground()
	end

	buildBackground()

	-- Animated gradient border
