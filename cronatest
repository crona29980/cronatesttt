local fovCircle = Instance.new("Frame")
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.BackgroundTransparency = 1
fovCircle.BorderSizePixel = 0
fovCircle.Visible = false
fovCircle.Parent = overlay
do
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = fovCircle
	local s = Instance.new("UIStroke")
	s.Thickness = 1.5
	s.Color = Color3.fromRGB(170, 100, 255)
	s.Parent = fovCircle
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getAimPart(character, root)
	if F.AimPart == "Head" then
		return character:FindFirstChild(CFG.HeadName, true) or root
	end
	return (CFG.TorsoName and character:FindFirstChild(CFG.TorsoName, true)) or root
end

local function isVisible(camera, part, character)
	rayParams.FilterDescendantsInstances = { localPlayer.Character, character }
	local origin = camera.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function getTarget(camera, mousePos)
	local best, bestDist = nil, F.AimFOV
	for _, player in ipairs(Players:GetPlayers()) do
		if player == localPlayer then continue end
		if F.AimTeamCheck and localPlayer.Team ~= nil and player.Team == localPlayer.Team then continue end

		local info = getInfo(player)
		if not info or info.health <= 0 then continue end
		local character = info.character
		local part = getAimPart(character, info.root)
		if not part or not part:IsA("BasePart") then continue end

		local pos, onScreen = camera:WorldToViewportPoint(part.Position)
		if not onScreen then continue end

		local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
		if dist < bestDist and (not F.AimWallCheck or isVisible(camera, part, character)) then
			best, bestDist = part, dist
		end
	end
	return best
end

RunService:BindToRenderStep("AimAssist", Enum.RenderPriority.Camera.Value + 1, function()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local mousePos = UserInputService:GetMouseLocation()

	fovCircle.Visible = F.Aim and F.AimFOVShow
	if fovCircle.Visible then
		fovCircle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
		fovCircle.Size = UDim2.fromOffset(F.AimFOV * 2, F.AimFOV * 2)
	end

	if not F.Aim or not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

	local target = getTarget(camera, mousePos)
	if target then
		local goal = CFrame.lookAt(camera.CFrame.Position, target.Position)
		camera.CFrame = camera.CFrame:Lerp(goal, F.AimSmooth)
	end
end)

