---------------------------------------------------------------------
local colorMap = {
	Purple = Color3.fromRGB(170, 100, 255),
	Red = Color3.fromRGB(255, 60, 60),
	Green = Color3.fromRGB(60, 255, 100),
	Blue = Color3.fromRGB(60, 160, 255),
	Yellow = Color3.fromRGB(255, 220, 60),
}
local rangeMap = { ["250"] = 250, ["500"] = 500, ["1000"] = 1000, ["2000"] = 2000, Unlimited = math.huge }

local overlay = Instance.new("ScreenGui")
overlay.Name = "ESPOverlay"
overlay.ResetOnSpawn = false
overlay.IgnoreGuiInset = true
overlay.DisplayOrder = 5
overlay.Parent = playerGui

local objects = {}

local function newFrame(parent)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.Visible = false
	f.Parent = parent
	return f
end

local MAX_BONES = 20

local function createObjects(player)
	if player == localPlayer or objects[player] then return end
	local obj = {}

	obj.box = newFrame(overlay)
	obj.box.BackgroundTransparency = 1
	obj.stroke = Instance.new("UIStroke")
	obj.stroke.Parent = obj.box

	obj.tracer = newFrame(overlay)
	obj.tracer.AnchorPoint = Vector2.new(0.5, 0.5)

	obj.bones = {}
	for i = 1, MAX_BONES do
		local line = newFrame(overlay)
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		obj.bones[i] = line
	end

	obj.hpBg = newFrame(overlay)
	obj.hpBg.BackgroundColor3 = Color3.new(0, 0, 0)
	obj.hpBg.BackgroundTransparency = 0.4
	obj.hpFill = Instance.new("Frame")
	obj.hpFill.BorderSizePixel = 0
	obj.hpFill.AnchorPoint = Vector2.new(0, 1)
	obj.hpFill.Position = UDim2.fromScale(0, 1)
	obj.hpFill.Size = UDim2.fromScale(1, 1)
	obj.hpFill.Parent = obj.hpBg

	obj.label = Instance.new("TextLabel")
	obj.label.BackgroundTransparency = 1
	obj.label.AnchorPoint = Vector2.new(0.5, 1)
	obj.label.Size = UDim2.fromOffset(240, 16)
	obj.label.Font = Enum.Font.GothamBold
	obj.label.TextSize = 13
	obj.label.TextStrokeTransparency = 0.4
	obj.label.Visible = false
	obj.label.Parent = overlay

	objects[player] = obj
end

local function destroyObjects(player)
	local obj = objects[player]
	if not obj then return end
	obj.box:Destroy()
	obj.tracer:Destroy()
	obj.hpBg:Destroy()
	obj.label:Destroy()
	for _, line in ipairs(obj.bones) do line:Destroy() end
	objects[player] = nil
end

local function hide2D(obj)
	obj.box.Visible = false
	obj.tracer.Visible = false
	obj.hpBg.Visible = false
	obj.label.Visible = false
	for _, line in ipairs(obj.bones) do line.Visible = false end
end

local function setLine(frame, a, b, thickness, color)
	local delta = b - a
	frame.Size = UDim2.fromOffset(delta.Magnitude, thickness)
	frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	frame.BackgroundColor3 = color
	frame.Visible = true
end

local function getColor(player)
	if F.ColorMode == "Team color" then return player.TeamColor.Color end
	return colorMap[F.ColorMode] or Color3.new(1, 1, 1)
end

-- Note: this uses Roblox's Team service. If your game tracks sides another way
-- (e.g. an attribute), change this function and the team check in the aim section.
-- If there are no teams, everyone counts as a "teammate".
local function passesFilter(player)
	if F.Show == "All players" then return true end
	local sameTeam = player.Team == localPlayer.Team
	if F.Show == "Teammates" then return sameTeam end
	return not sameTeam
end

local function getOrigin(viewport)
	local mode = F.TracerOrigin
	if mode == "Center" then return viewport / 2 end
	if mode == "Top" then return Vector2.new(viewport.X / 2, 0) end
	if mode == "Mouse" then return UserInputService:GetMouseLocation() end
	return Vector2.new(viewport.X / 2, viewport.Y)
end

local function setHighlight(character, on, color)
	local hl = character:FindFirstChild("ESPHighlight")
	if on then
		if not hl then
			hl = Instance.new("Highlight")
			hl.Name = "ESPHighlight"
			hl.OutlineColor = Color3.new(1, 1, 1)
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = character
		end
		hl.FillColor = color
		hl.FillTransparency = F.ChamsTransparency
	elseif hl then
		hl:Destroy()
	end
end

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local maxDistance = rangeMap[F.MaxRange] or math.huge
	local origin = getOrigin(viewport)
	local thickness = F.LineThickness

	for player, obj in pairs(objects) do
		local info = getInfo(player)
		local character = info and info.character
		local root = info and info.root

		local valid = F.ESP and info ~= nil and info.health > 0 and passesFilter(player)
		local distance = 0
		if valid then
			distance = (camera.CFrame.Position - root.Position).Magnitude
			if distance > maxDistance then valid = false end
		end

		if character then
			setHighlight(character, valid and F.Chams, valid and getColor(player) or Color3.new())
		end

		if not valid then
			hide2D(obj)
			continue
		end

		local color = getColor(player)

		-- Box fitted to the whole model, so it works with any character shape
		local boxCF, boxSize = character:GetBoundingBox()
		local top = camera:WorldToViewportPoint(boxCF.Position + Vector3.new(0, boxSize.Y / 2, 0))
		local bottom = camera:WorldToViewportPoint(boxCF.Position - Vector3.new(0, boxSize.Y / 2, 0))
		if top.Z <= 0 or bottom.Z <= 0 then
			hide2D(obj)
			continue
		end

		local height = math.abs(bottom.Y - top.Y)
		local width = height * 0.55
		local cx = top.X
		local x = cx - width / 2
		local y = top.Y

		obj.box.Visible = F.Boxes
		if F.Boxes then
			obj.box.Position = UDim2.fromOffset(x, y)
			obj.box.Size = UDim2.fromOffset(width, height)
			obj.stroke.Color = color
			obj.stroke.Thickness = thickness
		end

		local parts = {}
		if F.Names then table.insert(parts, player.DisplayName) end
		if F.Distance then table.insert(parts, "[" .. math.floor(distance) .. "]") end
		if #parts > 0 then
			obj.label.Text = table.concat(parts, " ")
			obj.label.TextColor3 = color
			obj.label.Position = UDim2.fromOffset(cx, y - 2)
			obj.label.Visible = true
		else
			obj.label.Visible = false
		end

		obj.hpBg.Visible = F.HealthBar
		if F.HealthBar then
			local pct = math.clamp(info.health / math.max(info.maxHealth, 1), 0, 1)
			obj.hpBg.Position = UDim2.fromOffset(x - 6, y)
			obj.hpBg.Size = UDim2.fromOffset(3, height)
			obj.hpFill.Size = UDim2.fromScale(1, pct)
			obj.hpFill.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 1, 1)
		end

		if F.Tracers then
			setLine(obj.tracer, origin, Vector2.new(cx, y + height), thickness, color)
		else
			obj.tracer.Visible = false
		end

		for i, line in ipairs(obj.bones) do
			local pair = CUSTOM_BONES[i]
			local partA = pair and F.Skeleton and character:FindFirstChild(pair[1], true)
			local partB = pair and F.Skeleton and character:FindFirstChild(pair[2], true)
			if partA and partB and partA:IsA("BasePart") and partB:IsA("BasePart") then
				local a = camera:WorldToViewportPoint(partA.Position)
				local b = camera:WorldToViewportPoint(partB.Position)
				if a.Z > 0 and b.Z > 0 then
					setLine(line, Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y), thickness, color)
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end
		end
	end
end)

for _, player in ipairs(Players:GetPlayers()) do createObjects(player) end
Players.PlayerAdded:Connect(createObjects)
Players.PlayerRemoving:Connect(destroyObjects)

