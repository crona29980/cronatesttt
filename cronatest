---------------------------------------------------------------------
-- Game adapter: EDIT THIS to match how your game stores character data
---------------------------------------------------------------------
local CFG = {
	HealthName = "Health",       -- attribute or NumberValue on the character
	MaxHealthName = "MaxHealth", -- same, optional (falls back to 100)
	RootName = nil,              -- main part name; nil = use the model's PrimaryPart
	HeadName = "Head",           -- part used when Aim target = Head
	TorsoName = nil,             -- part used when Aim target = Torso; nil = root part
}

-- Skeleton bones: pairs of part names inside YOUR character model.
-- Leave empty to skip the skeleton. Example:
-- { "Head", "Torso" }, { "Torso", "LeftArm" }, { "Torso", "RightArm" },
local CUSTOM_BONES = {
}

local function readNumber(character, name)
	local v = character:GetAttribute(name)
	if type(v) == "number" then return v end
	local obj = character:FindFirstChild(name, true)
	if obj and obj:IsA("ValueBase") and type(obj.Value) == "number" then return obj.Value end
	return nil
end

-- Returns { character, root, health, maxHealth } or nil if the player has no usable character.
local function getInfo(player)
	local character = player.Character
	if not character or not character:IsA("Model") then return nil end
	local root = (CFG.RootName and character:FindFirstChild(CFG.RootName, true))
		or character.PrimaryPart
		or character:FindFirstChildWhichIsA("BasePart", true)
	if not root then return nil end
	local health = readNumber(character, CFG.HealthName) or 100 -- no health data = treat as alive
	local maxHealth = readNumber(character, CFG.MaxHealthName) or math.max(health, 100)
	return { character = character, root = root, health = health, maxHealth = maxHealth }
end

