---------------------------------------------------------------------
-- Mini UI library
---------------------------------------------------------------------
local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = parent
	return c
end

local function tween(obj, props, time, style)
	TweenService:Create(obj,
		TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props):Play()
end

local function gradSeq(t)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, t.Accent),
		ColorSequenceKeypoint.new(0.5, t.Accent2),
		ColorSequenceKeypoint.new(1, t.Accent),
	})
end

local UI = {}

function UI:CreateWindow(opts)
	local themeName = Themes[opts.Theme] and opts.Theme or "Purple"
	local theme = Themes[themeName]
	local window = { Flags = { Theme = themeName }, Setters = {}, Tabs = {}, ThemeName = themeName, Open = true }
	local bindings, gradients = {}, {}

	local saving = opts.ConfigurationSaving
	local configKey = "UIConfig_" .. ((saving and saving.FolderName) or opts.Name or "Hub")
	local autoSave = saving and saving.Enabled

	-- bind(obj, prop, "Key" | function(theme) -> value): themed property that
	-- re-tweens whenever the theme changes.
	local function bind(obj, prop, fn)
		if type(fn) == "string" then
			local key = fn
			fn = function(t) return t[key] end
		end
		obj[prop] = fn(theme)
		table.insert(bindings, { obj = obj, prop = prop, fn = fn })
	end

	local function addGradient(parent)
		local g = Instance.new("UIGradient")
		g.Color = gradSeq(theme)
		g.Parent = parent
		table.insert(gradients, g)
		return g
	end

	local function makeLabel(parent, text, align, colorKey)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Text = text
		l.Font = Enum.Font.Gotham
		l.TextSize = 13
		l.TextXAlignment = align or Enum.TextXAlignment.Left
		bind(l, "TextColor3", colorKey or "Text")
		l.Parent = parent
		return l
	end

